# FORGE Environment Configuration Example
# Copy this file to .env and customize values as appropriate.
# Never commit .env or any real API keys to version control.

# Application Environment
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO

# Storage & Workspaces
FORGE_DB_PATH=forge.sqlite3
FORGE_WORKSPACE_DIR=/tmp/forge_workspaces

# ============================================================
# LLM Provider Configuration
# ============================================================
# Supported providers: fake | ollama | ollama_cloud | groq | gemini | deepseek | openai
#
# fake          — deterministic offline mock; no credentials; used in CI/tests.
# ollama        — local Ollama server; no API key required; runs on your machine.
# ollama_cloud  — hosted Ollama Cloud (https://ollama.com/v1); requires OLLAMA_API_KEY.
# groq          — Groq Cloud (free tier); requires GROQ_API_KEY.
# gemini        — Google Gemini (free tier); requires GEMINI_API_KEY.
# deepseek      — DeepSeek API (free tier); requires DEEPSEEK_API_KEY.
# openai        — OpenAI API (paid); requires FORGE_LLM_API_KEY.
FORGE_LLM_PROVIDER=ollama

# Model identifier — leave blank to use the provider's documented default.
# Examples: llama3 (ollama), gemma4:cloud (ollama_cloud), llama-3.3-70b-versatile (groq),
#           gemini-2.0-flash (gemini), deepseek-chat (deepseek), gpt-4o (openai)
FORGE_LLM_MODEL=

# Ollama local base URL — matches Friday's OLLAMA_BASE_URL convention.
# Default: http://localhost:11434 (no trailing slash needed)
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Cloud API key — required when FORGE_LLM_PROVIDER=ollama_cloud
# Endpoint: https://ollama.com/v1 (initial model: gemma4:cloud)
OLLAMA_API_KEY=

# Groq Cloud API key — reuse Friday's GROQ_API_KEY if available.
GROQ_API_KEY=

# Google Gemini API key — reuse Friday's GEMINI_API_KEY if available.
GEMINI_API_KEY=

# DeepSeek API key — reuse Friday's DEEPSEEK_API_KEY if available.
DEEPSEEK_API_KEY=

# OpenAI API key (FORGE-specific prefix, paid service).
FORGE_LLM_API_KEY=

# Base URL override — leave blank for provider defaults.
# Example for Azure OpenAI: https://<resource>.openai.azure.com/openai/deployments/<deployment>
FORGE_LLM_API_BASE=

# Security: automatic cloud fallback is DISABLED by policy.
# Do not set this to true.
FORGE_ALLOW_CLOUD_FALLBACK=false

# Execution Limits
FORGE_MAX_STEPS=10
FORGE_STEP_TIMEOUT_SECONDS=60
FORGE_MAX_OUTPUT_BYTES=50000
FORGE_MAX_CONTEXT_TOKENS=8000

# Docker sandbox base image
FORGE_DOCKER_IMAGE=python:3.11-slim
