# FORGE Environment Configuration Example
# Copy this file to .env and customize values as appropriate.
# Never commit real API keys or credentials to version control.

# Application Environment
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO

# Storage & Workspaces
FORGE_DB_PATH=forge.sqlite3
FORGE_WORKSPACE_DIR=/tmp/forge_workspaces

# LLM Provider Configuration
FORGE_LLM_PROVIDER=fake
FORGE_LLM_API_KEY=
FORGE_LLM_MODEL=gpt-4o
FORGE_LLM_API_BASE=

# Execution Limits
FORGE_MAX_STEPS=10
FORGE_STEP_TIMEOUT_SECONDS=60
FORGE_MAX_OUTPUT_BYTES=50000
FORGE_MAX_CONTEXT_TOKENS=8000
