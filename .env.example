# FORGE Environment Configuration Example
# Copy this file to .env and customize values as appropriate.
# Never commit real API keys or credentials to version control.

# Application Environment
FORGE_ENV=development
FORGE_LOG_LEVEL=INFO

# Storage & Workspaces
FORGE_DB_PATH=forge.sqlite3
FORGE_WORKSPACE_DIR=/tmp/forge_workspaces

# ============================================================
# LLM Provider Configuration (Milestone 5)
# ============================================================
# Set FORGE_LLM_PROVIDER to 'fake' for offline tests/CI (no API key needed).
# Set to 'openai' for OpenAI-compatible providers (requires API key).
FORGE_LLM_PROVIDER=fake

# API key for real LLM providers.
# For OpenAI: set to your sk-... API key.
# For Azure OpenAI, local Ollama/vLLM, leave blank and set FORGE_LLM_API_BASE.
FORGE_LLM_API_KEY=

# Model identifier (e.g. gpt-4o, gpt-4o-mini, llama3, etc.)
FORGE_LLM_MODEL=gpt-4o

# Custom API base URL for non-standard endpoints.
# Examples:
#   Azure OpenAI: https://<your-resource>.openai.azure.com/openai/deployments/<deployment>
#   Ollama:       http://localhost:11434/v1
#   vLLM:         http://localhost:8000/v1
FORGE_LLM_API_BASE=

# Execution Limits
FORGE_MAX_STEPS=10
FORGE_STEP_TIMEOUT_SECONDS=60
FORGE_MAX_OUTPUT_BYTES=50000
FORGE_MAX_CONTEXT_TOKENS=8000
